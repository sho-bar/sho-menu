{
    "include": [
        "resources/common/ts/**/*",
        "resources/menu/ts/**/*",
        "resources/admin/ts/**/*",
    ],
    "compilerOptions": {
        "target": "es5",
        "module": "es2022",
        "moduleResolution": "Node",
        "lib": [
            "es2021",
            "dom",
            "WebWorker"
        ],
        "sourceMap": true,
        "removeComments": true,
        "noEmitOnError": true,
        "strict": true,
        "noImplicitAny": false,
        "paths": {
            "@/*": [
                "./resources/common/ts/*"
            ],
            "@menu/*": [
                "./resources/menu/ts/*"
            ],
            "@admin/*": [
                "./resources/admin/ts/*"
            ],
        },
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    }
}